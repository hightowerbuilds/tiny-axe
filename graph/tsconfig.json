{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src",
    "test",
    "web",
    "scripts",
    "build.ts"
  ]
}
