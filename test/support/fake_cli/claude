#!/usr/bin/env elixir
# A stand-in for `claude -p --output-format stream-json` in tests, so no test
# uses the real subscription. It answers with what it was given, as JSON
# (arguments, stdin, folder, which API-key variables it could see), in the
# event format recorded in docs/plan-browser-and-cli-models.md.
#
# "SCENARIO:<name>" in the prompt picks a failure: not_logged_in, api_key,
# usage_limit, garbage, or sleep:<file> (writes its OS pid to <file>, then hangs).

argv = System.argv()
stdin = case IO.read(:stdio, :eof) do
  text when is_binary(text) -> text
  _ -> ""
end

emit = fn event -> IO.puts(JSON.encode!(event)) end

# As a driver: "SCENARIO:tool:<name>:<json>" makes one tool call through the
# gate, the way the real CLI would, and the answer includes its result.
call_gate = fn url, token, name, args ->
  :inets.start()
  body = JSON.encode!(%{jsonrpc: "2.0", id: 1, method: "tools/call", params: %{name: name, arguments: args}})
  headers = [{~c"authorization", String.to_charlist("Bearer " <> token)}]

  case :httpc.request(:post, {String.to_charlist(url), headers, ~c"application/json", body}, [timeout: 60_000], []) do
    {:ok, {{_, 200, _}, _, reply}} ->
      result = JSON.decode!(to_string(reply))["result"]
      %{"error" => result["isError"] == true, "text" => Enum.map_join(result["content"], " ", &(&1["text"] || ""))}

    other ->
      %{"error" => true, "text" => inspect(other)}
  end
end

tool_call = fn stdin, url, token ->
  case Regex.run(~r/SCENARIO:tool:([\w-]+):(\{.*?\})(?:\s|$)/s, stdin) do
    [_, name, args] when is_binary(url) -> call_gate.(url, token, name, JSON.decode!(args))
    _ -> nil
  end
end

# The gate's address and token, from --mcp-config, as Claude Code reads them.
mcp_config =
  case Enum.drop_while(argv, &(&1 != "--mcp-config")) do
    ["--mcp-config", file | _] -> JSON.decode!(File.read!(file))
    _ -> nil
  end

{gate_url, gate_token} =
  case mcp_config do
    %{"mcpServers" => %{"tinyaxe" => %{"url" => url, "headers" => %{"Authorization" => "Bearer " <> t}}}} -> {url, t}
    _ -> {nil, nil}
  end
scenario = case Regex.run(~r/SCENARIO:(\S+)/, stdin) do
  [_, s] -> s
  nil -> nil
end

model = case Enum.drop_while(argv, &(&1 != "--model")) do
  ["--model", m | _] -> "claude-#{m}-test"
  _ -> "claude-default-test"
end

# Real CLIs print the odd non-JSON line (warnings) along with their events.
IO.puts(:stderr, "warning: this is not JSON")

case scenario do
  "sleep:" <> file ->
    File.write!(file, System.pid())
    Process.sleep(:infinity)

  "garbage" ->
    IO.puts("something went badly wrong")
    System.halt(2)

  _ ->
    :ok
end

key_source = if scenario == "api_key", do: "ANTHROPIC_API_KEY", else: "none"
emit.(%{type: "system", subtype: "init", apiKeySource: key_source, model: model, tools: []})

reply =
  JSON.encode!(%{
    tool_result: tool_call.(stdin, gate_url, gate_token),
    mcp_config: mcp_config,
    args: argv,
    stdin: stdin,
    cwd: File.cwd!(),
    files: File.ls!("."),
    api_keys:
      Enum.filter(~w(ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY), &System.get_env/1)
  })

case scenario do
  "not_logged_in" ->
    emit.(%{type: "result", subtype: "success", is_error: true, result: "Not logged in · Please run /login"})
    System.halt(1)

  "usage_limit" ->
    emit.(%{type: "rate_limit_event", rate_limit_info: %{status: "rejected", resetsAt: 1_790_673_600}})
    emit.(%{type: "result", subtype: "success", is_error: true, result: "You've hit your limit"})
    System.halt(1)

  _ ->
    delta = fn d -> emit.(%{type: "stream_event", event: %{type: "content_block_delta", index: 0, delta: d}}) end
    delta.(%{type: "thinking_delta", thinking: "hmm"})

    # With a schema, the real CLI answers through a tool call: no text deltas.
    unless "--json-schema" in argv do
      {a, b} = String.split_at(reply, div(String.length(reply), 2))
      delta.(%{type: "text_delta", text: a})
      delta.(%{type: "text_delta", text: b})
    end
    emit.(%{type: "assistant", message: %{content: [%{type: "text", text: reply}]}})

    emit.(%{
      type: "rate_limit_event",
      rate_limit_info: %{
        status: "allowed",
        resetsAt: 1_790_673_600,
        unifiedWindows: %{five_hour: %{utilization: 0.09}, seven_day: %{utilization: 0.21}}
      }
    })

    structured = if "--json-schema" in argv, do: %{structured_output: %{"reply" => reply}}, else: %{}

    emit.(
      Map.merge(
        %{
          type: "result",
          subtype: "success",
          is_error: false,
          result: reply,
          duration_api_ms: 900,
          usage: %{input_tokens: 400, cache_read_input_tokens: 28, output_tokens: 42}
        },
        structured
      )
    )
end
