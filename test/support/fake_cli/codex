#!/usr/bin/env elixir
# A stand-in for `codex` in tests, so no test uses the real subscription.
# `codex login status` reports a ChatGPT login; `codex exec --json` answers
# with what it was given, as JSON (arguments, stdin, folder, the schema file,
# which API-key variables it could see), in the event format recorded in
# docs/plan-browser-and-cli-models.md.
#
# "SCENARIO:<name>" in the prompt picks a failure: error, usage_limit.

argv = System.argv()

if Enum.take(argv, 2) == ["login", "status"] do
  IO.puts("Logged in using ChatGPT")
  System.halt(0)
end

stdin = case IO.read(:stdio, :eof) do
  text when is_binary(text) -> text
  _ -> ""
end

emit = fn event -> IO.puts(JSON.encode!(event)) end

# As a driver: "SCENARIO:tool:<name>:<json>" makes one tool call through the
# gate, the way the real CLI would, and the answer includes its result.
call_gate = fn url, token, name, args ->
  :inets.start()
  body = JSON.encode!(%{jsonrpc: "2.0", id: 1, method: "tools/call", params: %{name: name, arguments: args}})
  headers = [{~c"authorization", String.to_charlist("Bearer " <> token)}]

  case :httpc.request(:post, {String.to_charlist(url), headers, ~c"application/json", body}, [timeout: 60_000], []) do
    {:ok, {{_, 200, _}, _, reply}} ->
      result = JSON.decode!(to_string(reply))["result"]
      %{"error" => result["isError"] == true, "text" => Enum.map_join(result["content"], " ", &(&1["text"] || ""))}

    other ->
      %{"error" => true, "text" => inspect(other)}
  end
end

tool_call = fn stdin, url, token ->
  case Regex.run(~r/SCENARIO:tool:([\w-]+):(\{.*?\})(?:\s|$)/s, stdin) do
    [_, name, args] when is_binary(url) -> call_gate.(url, token, name, JSON.decode!(args))
    _ -> nil
  end
end

# The gate's address from -c mcp_servers.tinyaxe.url=..., its token from the
# environment variable named by bearer_token_env_var, as Codex reads them.
setting = fn key ->
  Enum.find_value(argv, fn arg ->
    case Regex.run(~r/\Amcp_servers\.tinyaxe\.#{key}="(.*)"\z/, arg) do
      [_, value] -> value
      nil -> nil
    end
  end)
end

gate_url = setting.("url")
gate_token = (var = setting.("bearer_token_env_var")) && System.get_env(var)
scenario = case Regex.run(~r/SCENARIO:(\S+)/, stdin) do
  [_, s] -> s
  nil -> nil
end

schema = case Enum.drop_while(argv, &(&1 != "--output-schema")) do
  ["--output-schema", file | _] -> File.read!(file)
  _ -> nil
end

emit.(%{type: "thread.started", thread_id: "test"})
emit.(%{type: "turn.started"})

case scenario do
  "error" ->
    emit.(%{type: "error", message: "something broke"})
    emit.(%{type: "turn.failed", error: %{message: "something broke"}})
    System.halt(1)

  "usage_limit" ->
    emit.(%{type: "error", message: "You've hit your usage limit. Try again later."})
    System.halt(1)

  _ ->
    reply =
      JSON.encode!(%{
        tool_result: tool_call.(stdin, gate_url, gate_token),
        args: argv,
        stdin: stdin,
        cwd: File.cwd!(),
        files: File.ls!("."),
        schema: schema,
        api_keys:
          Enum.filter(~w(ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY), &System.get_env/1)
      })

    emit.(%{type: "item.completed", item: %{id: "item_0", type: "reasoning", text: "thinking"}})
    emit.(%{type: "item.completed", item: %{id: "item_1", type: "agent_message", text: reply}})
    emit.(%{type: "turn.completed", usage: %{input_tokens: 11_472, output_tokens: 48}})
end
