#!/bin/sh
# A stand-in for libsecret's secret-tool in tests. Two fixed secrets ("github"
# and a test card, "card-test"); anything stored goes to files in
# $TMPDIR/tiny_axe_fake_keyring (stdin, as the real one reads it).
dir="${TMPDIR:-/tmp}/tiny_axe_fake_keyring"
case "$1" in
  lookup)
    # lookup service tiny-axe key NAME
    case "$5" in
      github) printf 'ghp_from_the_keyring\n'; exit 0 ;;
      card-test) printf '{"number":"4111 1111 1111 1111","exp_month":"12","exp_year":"2030","cvc":"737","name":"Sam Lee"}\n'; exit 0 ;;
    esac
    [ -f "$dir/$5" ] && cat "$dir/$5" && exit 0
    exit 1 ;;
  store)
    # store --label=L service tiny-axe key NAME, the secret on stdin
    mkdir -p "$dir" && chmod 700 "$dir"
    cat > "$dir/$6"
    exit 0 ;;
  clear)
    rm -f "$dir/$5"; exit 0 ;;
esac
exit 1
