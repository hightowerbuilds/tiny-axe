#!/bin/sh
# A stand-in for libsecret's secret-tool in tests: the secret "github", and a
# test virtual card, "card-test".
if [ "$1 $2 $3 $4" = "lookup service tiny-axe key" ]; then
  case "$5" in
    github) printf 'ghp_from_the_keyring\n'; exit 0 ;;
    card-test) printf '{"number":"4111 1111 1111 1111","exp_month":"12","exp_year":"2030","cvc":"737","name":"Sam Lee"}\n'; exit 0 ;;
  esac
fi
exit 1
