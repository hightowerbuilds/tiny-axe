#!/usr/bin/env bash
# Development launcher (named -dev so it never shadows the installed `tiny-axe`): runs tiny-axe from this repo with mix, starting in the
# folder you run it from. To install a `tiny-axe` command that doesn't need the
# repo, run `mix tiny_axe.install` instead.
set -euo pipefail
project="$PWD"
home="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# `tiny-axe-dev graph [--port N] [--vault DIR]`: the know-how graph viewer,
# built from graph/ and run with Node (no BEAM).
if [ "${1:-}" = "graph" ]; then
  shift
  [ -d "$home/graph/node_modules" ] || npm --prefix "$home/graph" ci --silent
  (cd "$home/graph" && npm run --silent build)
  exec node "$home/graph/dist/server.js" "$@"
fi

cd "$home"
exec mise exec -- mix tiny_axe --dir "$project" "$@"
